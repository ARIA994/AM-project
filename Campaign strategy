        "jsCode": "// ===== PARSE REPORT FROM JSON ARRAY WITH ESCAPED STRING =====\n\nconst input = $input.first().json;\n\n// Handle different input formats\nlet reportData;\n\nif (Array.isArray(input)) {\n  // Input is array: [{ \"report\": \"...\" }]\n  reportData = input[0];\n} else {\n  // Input is object: { \"report\": \"...\" }\n  reportData = input;\n}\n\n// Get the escaped report string\nlet reportText = reportData.report;\n\n// The report is properly escaped JSON string, just needs unescaping\n// It's already unescaped when parsed as JSON, so reportText is now clean text\n\n// Extract metadata JSON from Section 0\nconst metadataMatch = reportText.match(/## SECTION 0: METADATA\\n\\n```json\\n([\\s\\S]*?)\\n```/);\n\nlet metadata = {};\nif (metadataMatch) {\n  try {\n    metadata = JSON.parse(metadataMatch[1]);\n  } catch (e) {\n    metadata = { error: \"Could not parse metadata JSON\" };\n  }\n}\n\n// Extract Campaign Learnings JSON from Section 8\nconst learningsMatch = reportText.match(/## SECTION 8: CAMPAIGN LEARNINGS JSON\\n\\n```json\\n([\\s\\S]*?)\\n```/);\n\nlet campaignLearnings = {};\nif (learningsMatch) {\n  try {\n    campaignLearnings = JSON.parse(learningsMatch[1]);\n  } catch (e) {\n    campaignLearnings = { error: \"Could not parse learnings JSON\" };\n  }\n}\n\n// Extract key metrics from text\nconst extractMetric = (pattern) => {\n  const match = reportText.match(pattern);\n  return match ? match[1] : null;\n};\n\n// Parse weekly data table if exists\nconst weeklyTableMatch = reportText.match(/\\| Week \\| Posts \\| Total Reach[\\s\\S]*?\\n\\n/);\nconst weeklyData = [];\n\nif (weeklyTableMatch) {\n  const rows = weeklyTableMatch[0].split('\\n').filter(line => line.includes('|') && !line.includes('---'));\n  \n  for (let i = 1; i < rows.length - 1; i++) { // Skip header and last empty\n    const cols = rows[i].split('|').map(c => c.trim()).filter(c => c);\n    if (cols.length >= 7 && cols[0] !== 'Week') {\n      weeklyData.push({\n        week: parseInt(cols[0]) || null,\n        posts: parseInt(cols[1]) || null,\n        total_reach: parseInt(cols[2].replace(/,/g, '')) || null,\n        avg_engagement_rate: parseFloat(cols[3]) || null,\n        median_save_rate: parseFloat(cols[4]) || null,\n        total_saves: parseInt(cols[5]) || null,\n        wow_change: cols[6]\n      });\n    }\n  }\n}\n\n// Parse Top 5 Posts table\nconst topPostsMatch = reportText.match(/### Top 5 Performing Posts[\\s\\S]*?\\| Rank[\\s\\S]*?\\n\\n/);\nconst topPosts = [];\n\nif (topPostsMatch) {\n  const rows = topPostsMatch[0].split('\\n').filter(line => line.includes('|') && !line.includes('---'));\n  \n  for (let i = 1; i < rows.length - 1; i++) {\n    const cols = rows[i].split('|').map(c => c.trim()).filter(c => c);\n    if (cols.length >= 8 && cols[0] !== 'Rank') {\n      topPosts.push({\n        rank: parseInt(cols[0]) || null,\n        post_id: cols[1],\n        week: parseInt(cols[2]) || null,\n        engagement_rate: parseFloat(cols[3]) || null,\n        save_rate: parseFloat(cols[4]) || null,\n        reach: parseInt(cols[5].replace(/,/g, '')) || null,\n        post_type: cols[6],\n        format: cols[7]\n      });\n    }\n  }\n}\n\n// Build structured output\nconst output = {\n  // Original full report text\n  report_text: reportText,\n  \n  // Extracted metadata\n  metadata: metadata,\n  \n  // Extracted learnings JSON\n  campaign_learnings: campaignLearnings,\n  \n  // Parsed weekly performance\n  weekly_performance: weeklyData,\n  \n  // Top performing posts\n  top_posts: topPosts,\n  \n  // Quick metrics summary\n  summary: {\n    campaign_id: metadata.campaign_id || \"CMP-001\",\n    campaign_name: metadata.campaign_name || \"Winter Drop: Textures & Layers\",\n    data_completeness_score: metadata.data_completeness_score || null,\n    overall_tier: metadata.overall_analysis_tier || null,\n    total_weeks: weeklyData.length,\n    total_posts: weeklyData.reduce((sum, w) => sum + (w.posts || 0), 0),\n    total_reach: weeklyData.reduce((sum, w) => sum + (w.total_reach || 0), 0),\n    avg_engagement_rate: weeklyData.length > 0 \n      ? (weeklyData.reduce((sum, w) => sum + (w.avg_engagement_rate || 0), 0) / weeklyData.length).toFixed(2)\n      : null,\n    top_post_id: topPosts[0]?.post_id || null,\n    top_post_engagement: topPosts[0]?.engagement_rate || null\n  },\n  \n  // Processing metadata\n  processed_at: new Date().toISOString(),\n  character_count: reportText.length\n};\n\nreturn { json: output };\n"
