      "parameters": {
        "jsCode": "// ===== CONVERT CAMPAIGN LOCK JSON TO READABLE TEXT =====\n\nconst input = $input.first().json;\n\n// Extract main campaign lock data\nconst campaignId = input[\"Campaign ID\"];\nconst campaignName = input[\"Campaign Name\"];\nconst lockId = input[\"Id\"];\nconst lockStatus = input[\"Lock Status\"];\nconst createdTime = input[\"createdTime\"];\nconst lockTimestamp = input[\"Lock Timestamp\"];\n\n// Build text report\nlet text = `# CAMPAIGN LOCK REPORT\\n\\n`;\ntext += `**Campaign:** ${campaignName} (${campaignId})\\n`;\ntext += `**Lock ID:** ${lockId}\\n`;\ntext += `**Lock Status:** ${lockStatus}\\n`;\ntext += `**Created:** ${createdTime}\\n`;\ntext += `**Lock Timestamp:** ${lockTimestamp}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Core Principle & Success\ntext += `## CAMPAIGN OBJECTIVE\\n\\n`;\ntext += `**Core Principle:** ${input[\"Core Principle\"]}\\n\\n`;\ntext += `**Success Definition:**\\n${input[\"Success Definition\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Visual System\ntext += `## VISUAL SYSTEM RULES\\n\\n`;\ntext += `### Environment\\n`;\ntext += `**Type:** ${input[\"Environment Type\"]}\\n`;\ntext += `**Allowed Materials:** ${input[\"Allowed Materials\"].join(', ')}\\n`;\ntext += `**Space Rules:** ${input[\"Space Rules\"]}\\n`;\ntext += `**Space Must Feel:** ${input[\"Space Must Feel\"].join(', ')}\\n\\n`;\n\ntext += `### Lighting\\n`;\ntext += `${input[\"Lighting Rules\"]}\\n\\n`;\n\ntext += `### Camera\\n`;\ntext += `${input[\"Camera Rules\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Color Palette\ntext += `## COLOR PALETTE\\n\\n`;\ntext += `**Primary:** ${input[\"campaign colors #1 \"]}\\n`;\ntext += `**Secondary:** ${input[\"campaign colors #2\"]}\\n`;\ntext += `**Tertiary:** ${input[\"campaign colors #3\"]}\\n`;\ntext += `**Color Rules:** ${input[\"color rules\"]}\\n`;\ntext += `**Allowed Behavior:** ${input[\"allowed color behavior \"]}\\n`;\ntext += `**Drift Tolerance:** ${input[\"Color Drift Tolerance\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Character Rules\ntext += `## CHARACTER SYSTEM\\n\\n`;\ntext += `**Authorized Characters:** ${input[\"Character Authorization\"]}\\n`;\ntext += `**Character Roles:** ${input[\"Character Role & Function\"]}\\n`;\ntext += `**Appearance Frequency:** ${input[\"Allowed Appearance Frequency\"]}\\n\\n`;\n\ntext += `### Character Constraints\\n`;\ntext += `**Physical/Visual:** ${input[\"Physical & Visual Constraints\"]}\\n`;\ntext += `**Posture & Motion:** ${input[\"Posture & Motion Rules\"]}\\n`;\ntext += `**Camera & Gaze:** ${input[\"Camera & Gaze Rules\"]}\\n`;\ntext += `**Prohibited Behavior:** ${input[\"Prohibited Character Behavior\"]}\\n`;\ntext += `**Exclusion Rule:** ${input[\"Character Exclusion Rule (Critical)\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Human Presence & Garment Rules\ntext += `## CONTENT RULES\\n\\n`;\ntext += `**Human Presence:** ${input[\"Human Presence Rules\"]}\\n`;\ntext += `**Garment Rules:** ${input[\"Garment Rules\"]}\\n`;\ntext += `**Caption Rules:** ${input[\"Caption Rules\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// AI Technical Locks\ntext += `## AI TECHNICAL LOCKS\\n\\n`;\ntext += `**AI Consistency Lock:** ${input[\"AI Consistency Lock Enabled\"] ? 'Enabled' : 'Disabled'}\\n`;\ntext += `**Frozen Prompt Version:** ${input[\"Frozen Prompt Version\"]}\\n`;\ntext += `**Frozen Negative Prompt:** ${input[\"Frozen Negative Prompt Version\"]}\\n`;\ntext += `**Frozen Model:** ${input[\"Frozen Model Version\"]}\\n`;\ntext += `**Mask Description ID:** ${input[\"Frozen Mask Description ID\"]}\\n\\n`;\n\ntext += `---\\n\\n`;\n\n// Post Data Summary\nif (input.data && input.data.length > 0) {\n  text += `## POST PERFORMANCE DATA\\n\\n`;\n  text += `**Total Posts:** ${input.data.length}\\n\\n`;\n  \n  // Calculate aggregate metrics\n  const totalReach = input.data.reduce((sum, post) => sum + (post.Reach || 0), 0);\n  const avgEngagement = input.data.reduce((sum, post) => sum + (post[\"engagements rate\"] || 0), 0) / input.data.length;\n  const totalSaves = input.data.reduce((sum, post) => sum + (post.Saves || 0), 0);\n  \n  text += `**Aggregate Metrics:**\\n`;\n  text += `- Total Reach: ${totalReach.toLocaleString()}\\n`;\n  text += `- Average Engagement Rate: ${(avgEngagement * 100).toFixed(2)}%\\n`;\n  text += `- Total Saves: ${totalSaves}\\n`;\n  text += `- Post Types: ${[...new Set(input.data.map(p => p[\"Post Type\"]))].join(', ')}\\n`;\n  text += `- Formats: ${[...new Set(input.data.map(p => p.format))].join(', ')}\\n\\n`;\n  \n  // Top 5 posts by engagement\n  const sortedByEngagement = [...input.data]\n    .sort((a, b) => (b[\"engagements rate\"] || 0) - (a[\"engagements rate\"] || 0))\n    .slice(0, 5);\n  \n  text += `### Top 5 Posts by Engagement Rate\\n\\n`;\n  text += `| Post ID | Week | Day | Type | Engagement Rate | Reach | Saves |\\n`;\n  text += `|---------|------|-----|------|-----------------|-------|-------|\\n`;\n  \n  sortedByEngagement.forEach(post => {\n    const engRate = ((post[\"engagements rate\"] || 0) * 100).toFixed(2);\n    text += `| ${post[\"Post ID\"]} | ${post[\"Week Number\"]} | ${post.Day} | ${post[\"Post Type\"]} | ${engRate}% | ${post.Reach} | ${post.Saves} |\\n`;\n  });\n  \n  text += `\\n`;\n  \n  // Week-by-week summary\n  const weeklyData = {};\n  input.data.forEach(post => {\n    const week = post[\"Week Number\"];\n    if (!weeklyData[week]) {\n      weeklyData[week] = {\n        posts: 0,\n        totalReach: 0,\n        totalEngagement: 0,\n        totalSaves: 0\n      };\n    }\n    weeklyData[week].posts++;\n    weeklyData[week].totalReach += post.Reach || 0;\n    weeklyData[week].totalEngagement += post[\"engagements rate\"] || 0;\n    weeklyData[week].totalSaves += post.Saves || 0;\n  });\n  \n  text += `### Weekly Performance Summary\\n\\n`;\n  text += `| Week | Posts | Avg Reach | Avg Engagement | Total Saves |\\n`;\n  text += `|------|-------|-----------|----------------|-------------|\\n`;\n  \n  Object.keys(weeklyData).sort((a, b) => a - b).forEach(week => {\n    const data = weeklyData[week];\n    const avgReach = Math.round(data.totalReach / data.posts);\n    const avgEng = ((data.totalEngagement / data.posts) * 100).toFixed(2);\n    text += `| ${week} | ${data.posts} | ${avgReach} | ${avgEng}% | ${data.totalSaves} |\\n`;\n  });\n  \n  text += `\\n`;\n}\n\ntext += `---\\n\\n`;\ntext += `**End of Campaign Lock Report**\\n`;\ntext += `Generated: ${new Date().toISOString()}`;\n\nreturn {\n  json: {\n    text: text,\n    campaign_id: campaignId,\n    campaign_name: campaignName,\n    lock_id: lockId,\n    post_count: input.data ? input.data.length : 0,\n    character_count: text.length,\n    generated_at: new Date().toISOString()\n  }\n};\n"
